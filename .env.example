# ============ 服务 ============
# python -m app.main 启动时的绑定地址（run.sh 由 HOST 环境变量控制，默认 0.0.0.0 便于远端浏览器访问）
HOST=127.0.0.1
PORT=8080

# ============ FunASR 流式推理 ============
# 协议：hy_stream（HY-ASR-3-Stream，逐词增量+语义VAD，推荐）/ qwen3_http（Qwen3-ASR HTTP 客户端拼装流式）/ funasr_nano（Fun-ASR-Nano vLLM）/ funasr（标准 FunASR 2pass）
ASR_PROTOCOL=hy_stream
# qwen3_http 协议（vLLM /v1/audio/transcriptions）：客户端 VAD 切句 + 周期重推出草稿
QWEN3_BACKEND=https://asr.example.com/s2
QWEN3_MODEL=qwen3asr17b
# qwen3asr 服务端鉴权密钥。服务端（services/opro 的 vLLM）未开 --api-key 时留空即可；
# 一旦服务端开启鉴权，这里填同一个 key，客户端会以 Authorization: Bearer <key> 发送。
QWEN3_TOKEN=xxxxx
# 草稿重推周期（秒音频），调小更跟手、请求更频。
# 注意请求量随句长放大：一段 15s 的话按 1.0 会重推约 15 次、每次重传整段音频
# （累计约 120s 音频）。服务端吃紧时调到 2.0 可把压力减半。
ASR_PARTIAL_INTERVAL=1.0
# 单次推理超时（秒）。与 LLM_TIMEOUT 独立 —— 两者合理值不同，且服务端排队时
# 同一段音频的延迟会在秒级到分钟级之间波动（实测 0.8s~60s），超时过紧会整段丢字，
# 表现就是「字幕时有时无」。超时/网络错误会自动重试一次，4xx 参数错误不重试。
ASR_INFER_TIMEOUT=60
# hy_stream 协议端点与鉴权（asr-gateway /tencent/asr/recognize/stream）
HY_ASR_WS_URL=wss://asr.example.com/tencent/asr/recognize/stream
HY_ASR_TOKEN=xxxxx
HY_ASR_MODEL=HY-ASR-3-Stream
# funasr_nano 协议默认端点：wss://asr.example.com/s2/ws
# funasr 协议端点由 FUNASR_SERV 推导
FUNASR_SERV=http://127.0.0.1:8002
# 流式 WebSocket 端点；留空则按协议自动推导
FUNASR_WS_URL=
# funasr 协议专用：推理模式 2pass / online / offline
ASR_MODE=2pass
# funasr 协议专用：chunk_size（逗号分隔，单位 60ms 帧）当前,回看,前看
ASR_CHUNK_SIZE=5,10,5
# funasr_nano 协议语种
ASR_LANGUAGE=中文
# 本地 VAD 主动切句：句尾静音即让服务端 flush，逐句快速出字（约 0.8s）
# 设为 false 则用服务端 VAD 断句（粒度粗，10~20s 才出一句）
LOCAL_VAD_SEGMENT=true

# ============ 转写 LLM 顺句改写 ============
# 终稿异步送 LLM 纠错别字/补标点/去口语赘词，完成后覆盖更新显示
REFINE_ENABLED=true
# 低于该字数的短句不送改写
REFINE_MIN_CHARS=12

# 热词词典（词<TAB>权重，# 注释跳过；会前可留空，由科学家背景自动生成）
HOTWORDS_PATH=hotwords_dict.txt

# ============ LLM（taiji，OpenAI 兼容 chat.completions）============
# llm_base 即完整端点，默认不再拼接 /v1/chat/completions
LLM_BASE=https://asr.example.com/tencent/llm/taiji
LLM_KEY=xxxxx
LLM_MODEL=hy3
LLM_TIMEOUT=30.0
# hy3 是思考模型，reasoning 与正文共享 token 预算（思考常占 500~3000 字），
# 预算过小会导致正文为空、校验报"过短(0<60)"，故给足额度
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.3
# 标准 OpenAI 兼容服务需拼路径时填 /v1/chat/completions，taiji 留空
LLM_CHAT_PATH=
# 「发言」任务的生成预算：发言稿最长 2 分钟（约 660 字），比短翻译长得多，
# 而 reasoning 与正文共享预算 —— 用 LLM_MAX_TOKENS 会被思考吃光导致正文为空。
SPEECH_MAX_TOKENS=6000

# ============ 说话人区分（CAM++ sidecar）============
# 打开后：每出一句转写，就把这句对应的现场语音送本地 CAM++ 做声纹判定，同一 session
# 内编号稳定（S1/S2/…）；控制台左栏与大屏字幕会在句子上方标出说话人，换人处画分隔线。
# 依赖 Python 环境（主程序是 Go，模型跑在 sidecar 进程里）：
#   - 由主程序自动拉起（DIARIZE_AUTOSTART=true 且 URL 指向本机时）：
#       首次运行 tools/diarize/run.sh 会自行建 venv、装 funasr/modelscope（约 200MB）、
#       下载 CAM++ 模型（约 28MB），耗时约 3~5 分钟；期间只是没有说话人标记，不影响开会。
#   - 也可手动起：bash tools/diarize/run.sh --port 18901
# 关闭时主链路完全不受影响；sidecar 不可达时只丢标记，转写照常。
DIARIZE_ENABLED=false
# sidecar 地址（一般就是本机）
DIARIZE_URL=http://127.0.0.1:18901
# 单段声纹判定超时（秒）：CPU 上 1~15s 音频实测 0.1~0.5s，余量留给首次加载。
# 注意它是「额外加在音频链路上的异步开销」，超时不会阻塞转写（只丢这一句的标记）。
DIARIZE_TIMEOUT=20
# 同一说话人判定阈值（余弦相似度，0~1）：调大更严格（更容易拆出新说话人），调小更宽容。
# 现场若同一个人被拆成好几个编号 → 调小（如 0.4）；若不同人判成同一个编号 → 调大（如 0.6）。
DIARIZE_THRESHOLD=0.5
# 短于该毫秒数的语音段不做判定：太短的音频声纹不稳，且省一次推理
DIARIZE_MIN_MS=600
# 启动时若 sidecar 不可达则自动拉起 run.sh（仅当上方 URL 指向本机；容器内无 python 时会失败并降级）
DIARIZE_AUTOSTART=true
# 排查用：打印每段语音的判定结果与「句子-语音段」的配对决策（编号乱跳/标记缺失时打开）。
# sidecar 自身每次判定也会打一行日志（含相似度），见 sessions/diarize.log。
DIARIZE_DEBUG=false

# ============ 讲稿文档解析（控制台「解析讲稿」上传演示稿）============
# 文档解析服务。网关上的 /tencent/read_url 只是它的一层壳（把 {url} 转成
# {file_url} 再转发过来），要求文件先有一个服务端可访问的 URL；直连本接口
# 可以收 multipart 上传（字段名 file），省掉「把上传目录暴露出去」这一步。
# 已验证支持 .pptx / .pdf / .md，中文正常。
DOC_PARSE_URL=https://ml-serv.ssv.qq.com/parse_doc
# 单次解析超时（秒）。解析耗时随体积线性增长：实测 17MB→17s、22MB→31s；
# 原硬编码 120s 余量偏紧，网络慢或服务端排队时会误报「文档解析服务不可达」。
DOC_PARSE_TIMEOUT=180
# 讲稿浓缩摘要的目标字数：上传时一次 LLM 调用同时产出「热词」和这份摘要，
# 摘要落进 materials/ 作为每次 AI 调用的 STATIC 背景（热词即时用于 ASR）。
# 上限 2400 —— 上下文组装时 STATIC 块会被截到 2500 字，超了会被静默截断。
# 实测上下文从 0 涨到 4309 prompt tokens，单次调用耗时仍是 1.1~1.7s（噪声级），
# 所以调大是安全的，不必为速度牺牲信息量。
DOC_DIGEST_CHARS=800
# 上传体积预检上限（字节）。真实上限来自 file 服务
# （ssv-ml-serv/services/file/fread_rs）的 axum DefaultBodyLimit，已调到 256MB；
# 这里取同一量级 —— 该服务会把整个文件读进内存（field.bytes()），完全放开有 OOM 风险。
#
# 历史坑（2026-09，记录以免重蹈）：该服务原先只设了 RequestBodyLimitLayer，
# 而 axum 的 Multipart 提取器读的是 DefaultBodyLimit（默认 2MB），后者对 Multipart
# 不生效 —— 于是 >2MB 的上传被截断，只报一句看不懂的
# "multipart bytes error: Error parsing `multipart/form-data` request"。
# 曾误判为网关 client_max_body_size 限制；实测网关侧 JSON 32MB 都能完整到达、
# Kong 配置里 client_max_body_size=0（不限制），真正原因在服务侧，已修复。
#
# 另注：PDF/PPTX 常因内嵌图片而虚大（实测一份 10 页论文 21 MB，文字层只有 41 KB），
# 若一时不便调大上限，用 pdftotext 转成纯文本再上传最省事。
DOC_MAX_BYTES=268435456

# ============ 音频 ============
SAMPLE_RATE=16000
FRAME_MS=20
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=600
MAX_SEGMENT_S=15

# ============ 数据与开关 ============
DATA_DIR=sessions
KEEP_AUDIO=false
WAKEWORD_AUTO=false
LOG_LEVEL=info
